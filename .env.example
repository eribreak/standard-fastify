# Application environment
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend_base

# Redis (optional — cache layer degrades gracefully when unavailable)
REDIS_URL=redis://localhost:6379

# OpenTelemetry (disabled by default; set OTEL_ENABLED=true to activate)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=backend-base
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# CORS
CORS_ORIGINS=http://localhost:3001